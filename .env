# ─────────────────────────────────────────────────────────────
# SkillBridge AI – environment configuration
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file (it is git-ignored).
# ─────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development
# Set to "true" when serving over HTTPS so session cookies are marked Secure
COOKIE_SECURE=false

# Database (SQLite file, created automatically)
DB_PATH=./data/skillbridge.db

# Admin account – created automatically on first start if no admin exists.
# If you leave ADMIN_PASSWORD empty, a random password is generated and
# printed ONCE in the server console.
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

# ── AI provider (Assessment, Gap Analysis, Jobs analysis, Resume, Coach)
# AI_PROVIDER: gemini | openai | anthropic
#   gemini    → free key at https://aistudio.google.com/apikey
#   openai    → any OpenAI-compatible API (OpenAI, Groq, OpenRouter, Together, ...)
#               set AI_BASE_URL for non-OpenAI providers
#   anthropic → https://console.anthropic.com
AI_PROVIDER=gemini
AI_API_KEY=AQ.Ab8RN6LkwynVuG3KQgcSNlVnqx5wUqKSWwyoj97HKZz8WDIIxw
# Optional overrides (sensible defaults are used when empty)
AI_MODEL=gemini-2.5-flash
AI_BASE_URL=
# If the main model is overloaded (HTTP 503) requests are retried with backoff, then sent to these
# comma-separated fallback models. Gemini defaults to: gemini-2.5-flash,gemini-2.5-flash-lite
AI_FALLBACK_MODELS=gemini-2.5-flash
AI_RETRIES=5
